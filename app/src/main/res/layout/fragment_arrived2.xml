<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/dp30"
    android:layout_marginEnd="@dimen/dp30"
    android:background="@drawable/bg_task_pause"
    android:gravity="center"
    android:orientation="horizontal">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp10"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp10"
            android:layout_weight="5"
            android:background="@drawable/bg_task_pause_content"
            android:gravity="center"
            android:orientation="vertical">


            <TextView
                android:id="@+id/title"
                android:layout_width="477dp"
                android:layout_height="159dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp20"
                android:lineSpacingMultiplier="0.8"
                android:maxWidth="500dp"
                android:text="请输入支付宝账号，以便后续收款"
                android:textAlignment="center"
                android:textSize="40sp" />

            <EditText
                android:id="@+id/payAccountInput"
                android:layout_width="412dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="请输入支付宝账号"
                android:maxLength="11"
                android:padding="16dp"
                android:textSize="18sp"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@._"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.9" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp20"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/dp10"
            android:paddingBottom="@dimen/dp10">
            <TextView
                android:id="@+id/tv_return_to_product_point"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/icon_yes"
                android:drawablePadding="@dimen/dp15"
                android:gravity="center"
                android:text="确认"
                android:textColor="@android:color/white"
                android:textSize="@dimen/sp18" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>